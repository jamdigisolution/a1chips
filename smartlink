<style>
:root{--bg:#120d09;--card:#211710;--gold:#f6b83f;--cream:#fff4df;--muted:#c9bba7}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:Arial,Helvetica,sans-serif;color:var(--cream);background-image:url('data:image/png;base64,');background-position:center top;background-size:cover;background-repeat:no-repeat;background-attachment:scroll;display:flex;justify-content:center;padding:28px 16px}
.wrap{width:100%;max-width:440px}
.hero{text-align:center;padding:28px 18px 24px}
.logo{width:104px;height:104px;border-radius:50%;overflow:hidden;margin:0 auto 17px;background:#4b1458;display:grid;place-items:center;box-shadow:0 10px 35px #0008;border:3px solid #f6b83f}.logo img{width:100%;height:100%;object-fit:cover;display:block}
h1{font-size:35px;letter-spacing:3px;margin:0;color:#ffcf69}
.tag{font-size:12px;letter-spacing:3px;color:#e8d5b8;margin:9px 0 0}
.intro{font-size:14px;color:var(--muted);margin:12px 0 0}
.links{display:grid;gap:13px;margin-top:12px}
a.link{display:flex;align-items:center;gap:15px;text-decoration:none;color:var(--cream);background:linear-gradient(135deg,#2c1d13,#1c130e);border:1px solid #73502d;border-radius:17px;padding:17px 18px;box-shadow:0 8px 22px #0004;transition:transform .18s,border-color .18s}
a.link:hover{transform:translateY(-2px);border-color:var(--gold)}
.icon{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;flex:none;background:#ffffff12;font-size:23px}.icon svg{width:34px;height:34px;display:block}.logo img{image-rendering:auto}
.label{font-size:16px;font-weight:700}
.sub{font-size:12px;color:var(--muted);margin-top:4px}
.arrow{margin-left:auto;color:var(--gold);font-size:22px}
.footer{text-align:center;color:#a9957b;font-size:11px;letter-spacing:1.5px;margin:26px 0 10px}
.note{text-align:center;color:#8e7c68;font-size:10px;margin-top:18px;line-height:1.6}
@media(min-width:600px){body{padding-top:45px}}
</style>
</head>
